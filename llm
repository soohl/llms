#!/usr/bin/env bash

set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

model_configs() {
    find "$ROOT/models" -mindepth 2 -maxdepth 2 \
        -type f -name model.conf -print | sort
}

clear_model_config() {
    unset MODEL_ID MODEL_NAME
    unset BACKEND
    unset LLAMACPP_REPO LLAMACPP_REVISION LLAMACPP_BUILD_NUMBER LLAMACPP_OS
    unset LLAMACPP_CUDA_ROOT LLAMACPP_CUDA_ARCHITECTURE
    unset DS4_REPO DS4_REVISION DS4_OS
    unset TARGET_HF_REPO SPECULATIVE_HF_REPO
    unset VARIANTS DEFAULT_VARIANT DOWNLOADS
    unset LLAMACPP_CONTEXT LLAMACPP_BATCH LLAMACPP_UBATCH LLAMACPP_THREADS
    unset LLAMACPP_CACHE_TYPE LLAMACPP_DEVICE LLAMACPP_GPU_LAYERS
    unset LLAMACPP_JINJA LLAMACPP_TEMPERATURE LLAMACPP_TOP_P LLAMACPP_TOP_K
    unset LLAMACPP_REASONING_STRENGTH LLAMACPP_SPECULATIVE_TYPE
    unset LLAMACPP_SPECULATIVE_DEFAULT LLAMACPP_SPECULATIVE_FILE
    unset LLAMACPP_SPECULATIVE_GPU_LAYERS LLAMACPP_SPECULATIVE_BATCH
    unset LLAMACPP_SPECULATIVE_UBATCH LLAMACPP_SPECULATIVE_MAX_TOKENS
    unset DS4_CONTEXT DS4_PREFILL_CHUNK DS4_KV_DISK_SPACE_MB
    unset DS4_SPECULATIVE_TYPE DS4_SPECULATIVE_DEFAULT
    unset DS4_SPECULATIVE_FILE DS4_SPECULATIVE_CONFIDENCE
}

load_model_config() {
    MODEL_DIR=$1
    clear_model_config
    set -a
    # model.conf is a tracked, repository-owned shell data file.
    # shellcheck disable=SC1090
    . "$MODEL_DIR/model.conf"
    backend_config="$ROOT/backends/config/${BACKEND:-}.conf"
    [ -f "$backend_config" ] || {
        printf 'Backend config is missing: %s\n' "$backend_config" >&2
        exit 1
    }
    # shellcheck disable=SC1090
    . "$backend_config"
    set +a

    for required in MODEL_ID MODEL_NAME BACKEND TARGET_HF_REPO VARIANTS \
        DEFAULT_VARIANT DOWNLOADS; do
        [ -n "${!required:-}" ] || {
            printf 'Missing %s in %s/model.conf\n' "$required" "$MODEL_DIR" >&2
            exit 1
        }
    done

    GGUF_ROOT="$MODEL_DIR/gguf"
    RUNTIME_ROOT="$MODEL_DIR/.runtime"
    BACKEND_ROOT="$ROOT/backends/$BACKEND"
    BACKEND_ADAPTER="$ROOT/backends/scripts/$BACKEND.sh"
}

resolve_model_dir() {
    requested=$1
    while IFS= read -r config; do
        dir=${config%/model.conf}
        load_model_config "$dir"
        if [ "$requested" = "$MODEL_ID" ]; then
            printf '%s\n' "$dir"
            return
        fi
    done < <(model_configs)
    printf 'Unknown model: %s\n' "$requested" >&2
    exit 2
}

resolve_backend() {
    requested=$1
    [ "$requested" = "$BACKEND" ] && return
    printf 'Backend %s is not configured for %s (use %s).\n' \
        "$requested" "$MODEL_NAME" "$BACKEND" >&2
    exit 2
}

resolve_variant() {
    requested=${1:-$DEFAULT_VARIANT}
    for variant in $VARIANTS; do
        if [ "$requested" = "$variant" ]; then
            printf '%s\n' "$variant"
            return
        fi
    done
    printf 'Unknown variant: %s (use %s)\n' "$requested" "$VARIANTS" >&2
    exit 2
}

variant_display() {
    result=
    for variant in $VARIANTS; do
        [ -z "$result" ] || result="$result, "
        result="$result$variant"
        [ "$variant" != "$DEFAULT_VARIANT" ] || result="$result (default)"
    done
    printf '%s\n' "$result"
}

list_models() {
    printf '%-24s %-10s %-24s %s\n' MODEL BACKEND VARIANTS RESULTS
    while IFS= read -r config; do
        load_model_config "${config%/model.conf}"
        result="models/${MODEL_DIR##*/}/BENCHMARK.md"
        printf '%-24s %-10s %-24s %s\n' \
            "$MODEL_ID" "$BACKEND" "$(variant_display)" "$result"
    done < <(model_configs)
}

usage() {
    cat <<'HELP'
Local LLM runner

Usage:
  ./llm list
  ./llm setup <model> <backend>
  ./llm download <model> <variant> [--speculative]
  ./llm serve <model> <backend> [variant] [--speculative on|off]
  ./llm benchmark <model> <backend> [variant] [--speculative off|on|compare]

Models are discovered from models/*/model.conf.
HELP
    printf '\nAvailable now:\n'
    list_models
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'Required command not found: %s\n' "$1" >&2
        exit 1
    }
}

download_model() {
    wanted=$1
    wanted_kind=${2:-target}
    mkdir -p "$GGUF_ROOT"
    found=0
    while IFS='|' read -r variant kind file expected_size; do
        [ "$variant" = "$wanted" ] || continue
        [ "$kind" = "$wanted_kind" ] || continue
        found=1
        path="$GGUF_ROOT/$file"
        if [ -e "$path" ]; then
            actual_size=$(wc -c <"$path" | tr -d '[:space:]')
            [ "$actual_size" = "$expected_size" ] || {
                printf 'Model file has the wrong size: %s\n' "$path" >&2
                printf 'Expected %s bytes, found %s.\n' \
                    "$expected_size" "$actual_size" >&2
                exit 1
            }
            printf 'Already downloaded and size verified: %s\n' "$path"
            continue
        fi

        require_command hf
        cache_dir="$RUNTIME_ROOT/huggingface"
        mkdir -p "$cache_dir"
        repo=$TARGET_HF_REPO
        speculative_file=${LLAMACPP_SPECULATIVE_FILE:-${DS4_SPECULATIVE_FILE:-}}
        if [ -n "${SPECULATIVE_HF_REPO:-}" ] &&
           [ "$file" = "$speculative_file" ]; then
            repo=$SPECULATIVE_HF_REPO
        fi
        args=(
            download "$repo" "$file"
            --repo-type model
            --local-dir "$GGUF_ROOT"
        )
        [ -z "${HF_TOKEN:-}" ] || args+=(--token "$HF_TOKEN")
        printf 'Downloading %s file: %s/%s\n' "$kind" "$repo" "$file"
        HF_HOME="$cache_dir" hf "${args[@]}"
        [ -f "$path" ] || {
            printf 'Download completed but the model file is missing: %s\n' \
                "$path" >&2
            exit 1
        }
        actual_size=$(wc -c <"$path" | tr -d '[:space:]')
        [ "$actual_size" = "$expected_size" ] || {
            printf 'Downloaded model has the wrong size: %s\n' "$path" >&2
            exit 1
        }
        printf 'Downloaded and size verified: %s\n' "$path"
    done <<<"$DOWNLOADS"
    [ "$found" = 1 ] || {
        printf 'No %s download configured for variant: %s\n' \
            "$wanted_kind" "$wanted" >&2
        exit 1
    }
    rm -rf "$GGUF_ROOT/.cache/huggingface"
    rmdir "$GGUF_ROOT/.cache" 2>/dev/null || true
}

run_backend() {
    action=$1
    variant=${2:-}
    speculative=${3:-}
    [ -x "$BACKEND_ADAPTER" ] || {
        printf 'Backend adapter is missing: %s\n' "$BACKEND_ADAPTER" >&2
        exit 1
    }
    export ROOT MODEL_DIR GGUF_ROOT RUNTIME_ROOT BACKEND_ROOT
    exec "$BACKEND_ADAPTER" "$action" "$variant" "$speculative"
}

parse_run_args() {
    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
    RUN_VARIANT=
    RUN_SPECULATIVE=
    while [ "$#" -gt 2 ]; do
        case "$3" in
            --speculative)
                [ "$#" -ge 4 ] || {
                    printf 'Missing value for --speculative.\n' >&2
                    exit 2
                }
                RUN_SPECULATIVE=$4
                shift 2
                ;;
            --speculative=*)
                RUN_SPECULATIVE=${3#*=}
                shift
                ;;
            --*)
                printf 'Unknown option: %s\n' "$3" >&2
                exit 2
                ;;
            *)
                [ -z "$RUN_VARIANT" ] || {
                    printf 'Unexpected argument: %s\n' "$3" >&2
                    exit 2
                }
                RUN_VARIANT=$3
                shift
                ;;
        esac
    done
}

select_model() {
    MODEL_DIR=$(resolve_model_dir "$1")
    load_model_config "$MODEL_DIR"
}

command=${1:-help}
case "$command" in
    help|-h|--help)
        usage
        ;;
    list)
        list_models
        ;;
    setup)
        [ "$#" -eq 3 ] || { usage >&2; exit 2; }
        select_model "$2"
        resolve_backend "$3" >/dev/null
        run_backend setup
        ;;
    download)
        [ "$#" -eq 3 ] || [ "$#" -eq 4 ] || {
            printf 'Download requires an explicit variant.\n\n' >&2
            usage >&2
            exit 2
        }
        download_kind=target
        if [ "$#" -eq 4 ]; then
            [ "$4" = --speculative ] || {
                printf 'Unknown download option: %s\n' "$4" >&2
                exit 2
            }
            download_kind=speculative
        fi
        select_model "$2"
        download_model "$(resolve_variant "$3")" "$download_kind"
        ;;
    serve|benchmark)
        parse_run_args "${@:2}"
        select_model "$2"
        resolve_backend "$3" >/dev/null
        case "${RUN_SPECULATIVE:-}" in
            ""|on|off) ;;
            compare)
                [ "$command" = benchmark ] || {
                    printf 'Speculative compare is benchmark-only.\n' >&2
                    exit 2
                }
                ;;
            *)
                printf 'Invalid speculative mode: %s\n' \
                    "$RUN_SPECULATIVE" >&2
                exit 2
                ;;
        esac
        run_backend "$command" "$(resolve_variant "$RUN_VARIANT")" \
            "$RUN_SPECULATIVE"
        ;;
    *)
        printf 'Unknown command: %s\n\n' "$command" >&2
        usage >&2
        exit 2
        ;;
esac
